# Copy to .env and fill in. Only synthetic / public patient text is ever sent to this API.
ANTHROPIC_API_KEY=
# Only when going through a proxy or gateway instead of api.anthropic.com (host only, no /v1/messages).
# ANTHROPIC_BASE_URL=

# Optional overrides
# TRIALMATCH_MODEL=claude-opus-5-5
# Model names that do not start with "claude" are called through an OpenAI-compatible
# /v1/chat/completions endpoint at ANTHROPIC_BASE_URL (or OPENAI_BASE_URL). Override with:
# TRIALMATCH_PROVIDER=auto
# TRIALMATCH_EFFORT=high
# TRIALMATCH_DATA_DIR=data
# Notes up to this many characters are sent to the model whole; longer ones use BM25 retrieval.
# TRIALMATCH_FULL_NOTE_MAX_CHARS=20000
# Set to 0 to judge without tools (date/threshold calculators, note search for long notes).
# TRIALMATCH_JUDGE_TOOLS=1
